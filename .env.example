FLASK_ENV=development

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_PROJECT_ID=your-project-id

# SECRET_KEY is deliberately absent. Leaving it unset makes the app generate a
# random 256-bit key in data/.secret_key on first start, which is what you want.
# Set it only to share one key across machines, and then use a real random value
# — a placeholder here would encrypt every credential under a published string.
